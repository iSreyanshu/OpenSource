.dashboard-wrapper
  
  / Sidebar Navigation
  %nav.sidebar
    .logo
      %img{src: "logo.png", alt: "Brand Logo"}/
      %span My Dashboard
    %ul
      %li
        %a.active{href: "/home"} Home
      %li
        %a{href: "/analytics"} Analytics
      %li
        %a{href: "/settings"} Settings

  / Main Content Area
  %main.main-content
    %header.top-bar
      %h2 Welcome Back, Rahul!
      .user-profile
        %img.avatar{src: "avatar.jpg"}/

    / Product Grid
    %section.product-grid
      
      / Card 1
      .card#card-101
        .badge.hot Hot
        %img{src: "iphone.jpg", alt: "iPhone 15"}/
        %h3 iPhone 15 Pro
        %p.price $999
        %button.btn-buy{onclick: "addToCart(101)"} Buy Now

      / Card 2
      .card#card-102
        %img{src: "macbook.jpg", alt: "MacBook"}/
        %h3 MacBook Air M3
        %p.price $1299
        %button.btn-buy{onclick: "addToCart(102)"} Buy Now
